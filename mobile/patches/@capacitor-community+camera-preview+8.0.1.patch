+    @PluginMethod
+    public void setZoom(PluginCall call) {
+        if (this.hasCamera(call) == false) {
+            call.reject("Camera is not running");
+            return;
+        }
+        try {
+            Integer level = call.getInt("level", 0);
+            Camera camera = fragment.getCamera();
+            Camera.Parameters params = camera.getParameters();
+            if (!params.isZoomSupported()) {
+                call.reject("Zoom not supported on this camera");
+                return;
+            }
+            int clamped = Math.max(0, Math.min(params.getMaxZoom(), level));
+            params.setZoom(clamped);
+            fragment.setCameraParameters(params);
+            call.resolve();
+        } catch (Exception e) {
+            Logger.debug(getLogTag(), "setZoom exception: " + e);
+            call.reject("failed to set zoom");
+        }
+    }
+
+    @PluginMethod
+    public void getZoomState(PluginCall call) {
+        if (this.hasCamera(call) == false) {
+            call.reject("Camera is not running");
+            return;
+        }
+        try {
+            Camera camera = fragment.getCamera();
+            Camera.Parameters params = camera.getParameters();
+            boolean supported = params.isZoomSupported();
+            JSObject state = new JSObject();
+            state.put("supported", supported);
+            state.put("max", supported ? params.getMaxZoom() : 0);
+            state.put("current", supported ? params.getZoom() : 0);
+            call.resolve(state);
+        } catch (Exception e) {
+            Logger.debug(getLogTag(), "getZoomState exception: " + e);
+            call.reject("failed to read zoom state");
+        }
+    }
+
